# Supabase — service role key, used only by the loader and GitHub Actions.
# NEVER commit the real values. NEVER expose the service role key to the browser.
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Optional: politeness knobs for the crawler
MYCLUJ_DELAY_MS=350
MYCLUJ_MAX_RETRIES=4
