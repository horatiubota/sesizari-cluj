      "html": "<header class=\"ds-header\"><a class=\"ds-wordmark\" href=\"#\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\"><rect x=\"1\" y=\"9\" width=\"3\" height=\"6\" rx=\"0.5\" fill=\"var(--o-fav,#4f7464)\"/><rect x=\"6.5\" y=\"5\" width=\"3\" height=\"10\" rx=\"0.5\" fill=\"var(--o-part,#c8b68c)\"/><rect x=\"12\" y=\"1\" width=\"3\" height=\"14\" rx=\"0.5\" fill=\"var(--ink,#17181a)\"/></svg>Sesizări Cluj</a><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Panou</a><a href=\"#\">Hartă</a><a href=\"#\">Recurente</a><a href=\"#\">Urmărite</a></nav><a class=\"ds-support\" href=\"#\">Ia-mi o cafea</a></header>",
      "css": ".ds-header{display:flex;align-items:center;gap:32px;padding:0 24px;height:48px;border-bottom:1px solid var(--line,#e2e2de);background:color-mix(in srgb,var(--surface,#fff) 95%,transparent);backdrop-filter:blur(4px);font-family:var(--font-inter,Inter),sans-serif}.ds-wordmark{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;letter-spacing:-.025em;color:var(--ink,#17181a);text-decoration:none}.ds-nav{display:flex}.ds-nav a{position:relative;display:flex;align-items:center;height:48px;padding:0 12px;font-size:14px;color:var(--ink-3,#66686d);text-decoration:none}.ds-nav a:hover{color:var(--ink,#17181a)}.ds-nav a[aria-current=page]{color:var(--ink,#17181a);font-weight:500}.ds-nav a[aria-current=page]::after{content:'';position:absolute;left:12px;right:12px;bottom:0;height:2px;border-radius:9999px;background:var(--ink,#17181a)}.ds-support{margin-left:auto;font-size:14px;color:var(--ink-3,#66686d);text-decoration:none}.ds-support:hover{color:var(--ink,#17181a)}.ds-header a:focus-visible{outline:2px solid var(--focus,#2b59c3);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Picker Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The single bordered panel per view; surface on bg, 8px corners, no shadow.",
      "html": "<section class=\"ds-panel\"><h2>Ce se întâmplă cu sesizările ca a mea?</h2><p>1.284 de sesizări depuse între 6 iul. și 4 oct., după cum s-au închis până acum:</p></section>",
      "css": ".ds-panel{max-width:560px;padding:24px;border:1px solid var(--line,#e2e2de);border-radius:8px;background:var(--surface,#fff);font-family:var(--font-inter,Inter),sans-serif}.ds-panel h2{margin:0;font-size:18px;font-weight:600;letter-spacing:-.025em;color:var(--ink,#17181a)}.ds-panel p{margin:4px 0 0;font-size:14px;line-height:1.625;color:var(--ink-2,#4a4c50)}"
    },
    {
      "name": "Outcome Strip with Legend",
      "kind": "custom",
      "refersTo": "outcome-strip-large",
      "description": "Signature: five-band 100% strip with printed shares; hatched transferred and open.",
      "html": "<div class=\"ds-os\"><div class=\"ds-os-strip\" role=\"img\" aria-label=\"Favorabil 61,2%, Parțial 3,1%, Transferată 9,4%, Respinsă 4,0%, Deschisă 22,3%\"><span class=\"ds-fav\" style=\"width:61.2%\"></span><span class=\"ds-part\" style=\"width:3.1%\"></span><span class=\"ds-transf\" style=\"width:9.4%\"></span><span class=\"ds-resp\" style=\"width:4%\"></span><span class=\"ds-open\" style=\"width:22.3%\"></span></div><ul class=\"ds-os-legend\"><li><i class=\"ds-fav\"></i>Favorabil<b>61,2%</b></li><li><i class=\"ds-part\"></i>Parțial<b>3,1%</b></li><li><i class=\"ds-transf\"></i>Transferată<b>9,4%</b></li><li><i class=\"ds-resp\"></i>Respinsă<b>4,0%</b></li><li><i class=\"ds-open\"></i>Deschisă<b>22,3%</b></li></ul><div class=\"ds-os-strip ds-thin\" style=\"margin-top:24px\" role=\"img\" aria-label=\"11 din 12 favorabil\"><span class=\"ds-fav\" style=\"width:91.7%\"></span><span class=\"ds-open\" style=\"width:8.3%\"></span></div></div>",
      "css": ".ds-os{font-family:var(--font-inter,Inter),sans-serif;max-width:640px}.ds-os-strip{display:flex;height:16px;overflow:hidden;border-radius:3px;background:var(--sunken,#efefec)}.ds-os-strip span{height:100%}.ds-thin{outline:1px dashed var(--ink-3,#66686d);outline-offset:2px}.ds-fav{background:var(--o-fav,#4f7464)}.ds-part{background:var(--o-part,#c8b68c)}.ds-resp{background:var(--o-resp,#2e3136)}.ds-transf{background-color:var(--o-transf-bg,#e3e6eb);background-image:repeating-linear-gradient(135deg,var(--o-transf,#6f7a8c) 0 1.5px,transparent 1.5px 5px)}.ds-open{background-color:var(--o-open,#e4e4df);background-image:repeating-linear-gradient(45deg,var(--o-open-hatch,#c4c4bd) 0 1px,transparent 1px 4px)}.ds-os-legend{display:grid;grid-template-columns:repeat(5,1fr);gap:8px 24px;margin:12px 0 0;padding:0;list-style:none;font-size:12px;color:var(--ink-3,#66686d)}.ds-os-legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}.ds-os-legend b{display:block;margin-top:2px;font-size:18px;font-weight:600;color:var(--ink,#17181a);font-variant-numeric:tabular-nums}"
    },
