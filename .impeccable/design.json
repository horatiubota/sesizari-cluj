      "name": "Text Action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Boxless action: ink-2 text with a strong-hairline underline that darkens on hover.",
      "html": "<button class=\"ds-textaction\">Descarcă CSV</button>",
      "css": ".ds-textaction{height:44px;padding:0 4px;background:none;border:0;font-family:var(--font-inter,Inter),sans-serif;font-size:14px;color:var(--ink-2,#4a4c50);text-decoration:underline;text-decoration-color:var(--line-strong,#c9c9c3);text-underline-offset:4px;cursor:pointer}.ds-textaction:hover{color:var(--ink,#17181a);text-decoration-color:var(--ink,#17181a)}.ds-textaction:focus-visible{outline:2px solid var(--focus,#2b59c3);outline-offset:2px;border-radius:2px}"
    },
