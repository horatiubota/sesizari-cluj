      "kind": "button",
      "refersTo": "button-toggle",
      "description": "Rectangular 44px toggle in a group; selected is ink fill with surface text.",
      "html": "<div class=\"ds-toggles\" role=\"group\"><button class=\"ds-toggle\" aria-pressed=\"true\">volum</button><button class=\"ds-toggle\" aria-pressed=\"false\">încă deschise</button><button class=\"ds-toggle\" aria-pressed=\"false\">respinse</button></div>",
      "css": ".ds-toggles{display:flex;gap:6px;flex-wrap:wrap;font-family:var(--font-inter,Inter),sans-serif}.ds-toggle{height:44px;padding:0 14px;border:1px solid var(--line-strong,#c9c9c3);border-radius:6px;background:var(--surface,#fff);color:var(--ink-2,#4a4c50);font-size:14px;cursor:pointer}.ds-toggle:hover{border-color:var(--ink,#17181a);color:var(--ink,#17181a)}.ds-toggle[aria-pressed=true]{background:var(--ink,#17181a);border-color:var(--ink,#17181a);color:var(--surface,#fff);font-weight:500}.ds-toggle:focus-visible{outline:2px solid var(--focus,#2b59c3);outline-offset:2px}"
    },
