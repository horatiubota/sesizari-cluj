      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">7 zile</button><button class=\"ds-chip\" aria-pressed=\"false\">30 de zile</button><button class=\"ds-chip\" aria-pressed=\"false\">1 an</button></div>",
      "css": ".ds-chips{display:flex;gap:4px;flex-wrap:wrap;font-family:var(--font-inter,Inter),sans-serif}.ds-chip{padding:4px 12px;border:1px solid var(--line-strong,#c9c9c3);border-radius:9999px;background:transparent;color:var(--ink-2,#4a4c50);font-size:12px;cursor:pointer;transition:all .15s}.ds-chip:hover{border-color:var(--ink-3,#66686d)}.ds-chip[aria-pressed=true]{background:var(--ink,#17181a);border-color:var(--ink,#17181a);color:var(--surface,#fff)}.ds-chip:focus-visible{outline:2px solid var(--focus,#2b59c3);outline-offset:2px}@media (pointer:coarse){.ds-chip{min-height:44px}}"
